{
  "rules": {
    ".read": false,
    ".write": false,

    "accounts": {
      ".read": true,
      "$account": {
        ".write": true,
        ".validate": "newData.hasChildren(['nickname', 'role']) && (newData.child('role').val() === 'dm' || newData.child('role').val() === 'player')"
      }
    },

    "inventories": {
      ".read": true,
      "$player": { ".write": true }
    },

    "inventory_backgrounds": {
      "$player": { ".read": true, ".write": true }
    },

    "prefs": {
      "$player": { ".read": true, ".write": true }
    },

    "campaign_notes": {
      "users": {
        "$owner": { ".read": true, ".write": true }
      }
    },

    "campaign_background": { ".read": true },
    "inventory": { ".read": true },

    "campaigns": {
      "$campaign": {
        ".read": true,
        ".write": true,
        "name": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 60" },
        "owner": { ".validate": "newData.isString() && newData.val().length <= 40" },
        "inviteCode": { ".validate": "newData.isString() && newData.val().matches(/^[A-Z0-9]{6}$/)" },
        "createdAt": { ".validate": "newData.isNumber()" },
        "members": {
          "$nick": {
            ".validate": "newData.hasChildren(['role'])",
            "role": { ".validate": "newData.val() === 'dm' || newData.val() === 'player'" },
            "character": { ".validate": "newData.isString() && newData.val().length <= 60" },
            "joinedAt": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          }
        },
        "notes": {
          "$note": {
            ".validate": "newData.hasChildren(['title', 'updatedAt'])",
            "title": { ".validate": "newData.isString() && newData.val().length <= 120" },
            "body": { ".validate": "newData.isString() && newData.val().length <= 20000" },
            "visibleTo": { ".validate": "newData.val() === 'all' || newData.hasChildren()" },
            "by": { ".validate": "newData.isString() && newData.val().length <= 40" },
            "createdAt": { ".validate": "newData.isNumber()" },
            "updatedAt": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          }
        },
        "homebrew": {
          "species": { "$id": { ".validate": "$id.matches(/^[a-z0-9_]{1,40}$/) && newData.child('name').isString()" } },
          "backgrounds": { "$id": { ".validate": "$id.matches(/^[a-z0-9_]{1,40}$/) && newData.child('name').isString()" } },
          "feats": { "$id": { ".validate": "$id.matches(/^[a-z0-9_]{1,40}$/) && newData.child('name').isString()" } },
          "spells": { "$id": { ".validate": "$id.matches(/^[a-z0-9_]{1,40}$/) && newData.child('name').isString() && newData.child('name').val().length <= 80 && newData.child('level').isNumber() && newData.child('level').val() >= 0 && newData.child('level').val() <= 9" } },
          "items": { "$id": { ".validate": "$id.matches(/^[a-z0-9_]{1,40}$/) && newData.child('name').isString() && newData.child('name').val().length <= 120" } },
          "subraces": { "$parent": { "$id": { ".validate": "$id.matches(/^[a-z0-9_]{1,40}$/) && newData.child('name').isString()" } } },
          "subclasses": { "$parent": { "$id": { ".validate": "$id.matches(/^[a-z0-9_]{1,40}$/) && newData.child('name').isString()" } } },
          "$other": { ".validate": false }
        },
        "settings": {
          "builder": {
            "allowManual": { ".validate": "newData.isBoolean()" },
            "strict": { ".validate": "newData.isBoolean()" },
            "$other": { ".validate": false }
          },
          "$other": { ".validate": false }
        },
        "$other": { ".validate": false }
      }
    },

    "invites": {
      "$code": {
        ".read": true,
        ".write": true,
        ".validate": "$code.matches(/^[A-Z0-9]{6}$/) && newData.isString() && newData.val().length <= 40"
      }
    },

    "characters": {
      "$character": {
        ".read": true,
        ".write": true,
        "name": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 60" },
        "owner": { ".validate": "newData.isString() && newData.val().length <= 40" },
        "createdAt": { ".validate": "newData.isNumber()" },
        "$other": { ".validate": false }
      }
    },

    "users": {
      "$nick": {
        ".read": true,
        "campaigns": { "$campaign": { ".write": true, ".validate": "newData.val() === true" } },
        "characters": { "$character": { ".write": true, ".validate": "newData.val() === true" } }
      }
    },

    "vtt": {
      "$room": {
        ".read": true,
        ".write": "!newData.exists()",
        "map": {
          ".write": true,
          "url": { ".validate": "newData.isString() && newData.val().length <= 1600000" },
          "width": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000" },
          "height": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000" },
          "catalogId": { ".validate": "newData.isString() && newData.val().length <= 80" },
          "$other": { ".validate": false }
        },
        "grid": {
          ".write": true,
          "size": { ".validate": "newData.isNumber() && newData.val() >= 10 && newData.val() <= 400" },
          "visible": { ".validate": "newData.isBoolean()" },
          "color": { ".validate": "newData.isString() && newData.val().length <= 20" },
          "opacity": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1" },
          "offsetX": { ".validate": "newData.isNumber() && newData.val() > -10000 && newData.val() < 10000" },
          "offsetY": { ".validate": "newData.isNumber() && newData.val() > -10000 && newData.val() < 10000" },
          "$other": { ".validate": false }
        },
        "tokens": {
          "$token": {
            ".write": true,
            "name": { ".validate": "newData.isString() && newData.val().length <= 60" },
            "id": { ".validate": "newData.isString() && newData.val() === $token" },
            "x": { ".validate": "newData.isNumber()" },
            "y": { ".validate": "newData.isNumber()" },
            "size": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 4" },
            "img": { ".validate": "newData.isString() && newData.val().length <= 200000" },
            "catalogId": { ".validate": "newData.isString() && newData.val().length <= 80" },
            "color": { ".validate": "newData.isString() && newData.val().length <= 20" },
            "owner": { ".validate": "newData.isString() && newData.val().length <= 40" },
            "hidden": { ".validate": "newData.isBoolean()" },
            "hp": {
              "current": { ".validate": "newData.isNumber() && newData.val() >= 0" },
              "max": { ".validate": "newData.isNumber() && newData.val() > 0" },
              "$other": { ".validate": false }
            },
            "ac": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 40" },
            "monsterId": { ".validate": "newData.isString() && newData.val().length <= 80" },
            "conditions": {
              "$condition": { ".validate": "($condition !== 'exhaustion' && newData.isBoolean()) || ($condition === 'exhaustion' && newData.isNumber() && newData.val() >= 1 && newData.val() <= 6)" }
            },
            "$other": { ".validate": false }
          }
        },
        "fog": {
          "enabled": { ".write": true, ".validate": "newData.isBoolean()" },
          "revealed": {
            ".write": true,
            "$cell": { ".validate": "newData.val() === true && $cell.matches(/^[0-9]+_[0-9]+$/)" }
          },
          "$other": { ".validate": false }
        },
        "shapes": {
          "$shape": {
            ".write": true,
            ".validate": "newData.hasChildren(['kind', 'ox', 'oy', 'ex', 'ey'])",
            "kind": { ".validate": "newData.val() === 'circle' || newData.val() === 'cone' || newData.val() === 'line' || newData.val() === 'square'" },
            "ox": { ".validate": "newData.isNumber()" },
            "oy": { ".validate": "newData.isNumber()" },
            "ex": { ".validate": "newData.isNumber()" },
            "ey": { ".validate": "newData.isNumber()" },
            "by": { ".validate": "newData.isString() && newData.val().length <= 40" },
            "color": { ".validate": "newData.isString() && newData.val().length <= 20" },
            "$other": { ".validate": false }
          }
        },
        "initiative": {
          ".write": true,
          "round": { ".validate": "newData.isNumber() && newData.val() >= 1" },
          "turn": { ".validate": "newData.isString() && newData.val().length <= 40" },
          "entries": {
            "$entry": {
              "name": { ".validate": "newData.isString() && newData.val().length <= 60" },
              "init": { ".validate": "newData.isNumber()" },
              "tokenId": { ".validate": "newData.isString() && newData.val().length <= 40" },
              "hidden": { ".validate": "newData.isBoolean()" },
              "at": { ".validate": "newData.isNumber()" },
              "$other": { ".validate": false }
            }
          },
          "$other": { ".validate": false }
        },
        "measure": {
          "$session": {
            ".write": true,
            "who": { ".validate": "newData.isString() && newData.val().length <= 40" },
            "ax": { ".validate": "newData.isNumber()" },
            "ay": { ".validate": "newData.isNumber()" },
            "bx": { ".validate": "newData.isNumber()" },
            "by": { ".validate": "newData.isNumber()" },
            "color": { ".validate": "newData.isString() && newData.val().length <= 20" },
            "at": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          }
        },
        "log": {
          "$entry": {
            ".write": true,
            ".validate": "newData.hasChildren(['by', 'die', 'result', 'at']) || newData.hasChildren(['by', 'expr', 'total', 'text', 'at']) || newData.hasChildren(['by', 'hidden', 'at'])",
            "by": { ".validate": "newData.isString() && newData.val().length <= 40" },
            "hidden": { ".validate": "newData.isBoolean()" },
            "expr": { ".validate": "newData.isString() && newData.val().length <= 200" },
            "total": { ".validate": "newData.isNumber()" },
            "text": { ".validate": "newData.isString() && newData.val().length <= 400" },
            "crit": { ".validate": "newData.isBoolean()" },
            "fumble": { ".validate": "newData.isBoolean()" },
            "label": { ".validate": "newData.isString() && newData.val().length <= 60" },
            "die": { ".validate": "newData.isNumber() && newData.val() >= 2 && newData.val() <= 100" },
            "result": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= newData.parent().child('die').val()" },
            "at": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          }
        },
        "audio": {
          ".write": true,
          ".validate": "newData.hasChildren(['url', 'playing'])",
          "url": { ".validate": "newData.isString() && newData.val().length <= 2100000 && (newData.val().beginsWith('https://') || newData.val().beginsWith('http://') || newData.val().beginsWith('data:audio/'))" },
          "title": { ".validate": "newData.isString() && newData.val().length <= 80" },
          "playing": { ".validate": "newData.isBoolean()" },
          "at": { ".validate": "newData.isNumber()" },
          "offset": { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "volume": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1" },
          "$other": { ".validate": false }
        },
        "logHidden": {
          "$entry": {
            ".write": true,
            ".validate": "newData.hasChildren(['by', 'expr', 'total', 'text', 'at'])",
            "by": { ".validate": "newData.isString() && newData.val().length <= 40" },
            "expr": { ".validate": "newData.isString() && newData.val().length <= 200" },
            "total": { ".validate": "newData.isNumber()" },
            "text": { ".validate": "newData.isString() && newData.val().length <= 400" },
            "crit": { ".validate": "newData.isBoolean()" },
            "fumble": { ".validate": "newData.isBoolean()" },
            "label": { ".validate": "newData.isString() && newData.val().length <= 60" },
            "at": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          }
        },
        "$other": { ".validate": false }
      }
    }
  }
}
